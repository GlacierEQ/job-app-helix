{
  "schema": "glaciereq.live-evidence-adapter-policy.v1",
  "version": "1.0.0",
  "authority": "GlacierEQ/job-app-helix",
  "principles": {
    "apex_repository_is_source_of_truth": true,
    "source_links_are_required": true,
    "copied_source_bytes_are_forbidden": true,
    "workflow_presence_is_not_execution_proof": true,
    "test_files_are_not_test_pass_proof": true,
    "ambiguous_ci_is_unverified": true,
    "authentication_is_never_inferred_from_tool_availability": true,
    "connector_quality_and_data_quality_are_separate": true
  },
  "execution_states": [
    "SUCCESS",
    "FAILURE",
    "IN_PROGRESS",
    "AMBIGUOUS",
    "NOT_CONFIGURED",
    "NOT_RUN"
  ],
  "connector_quality_points": {
    "repository_metadata_receipt": 25,
    "head_commit_receipt": 25,
    "sha_bound_artifact_receipts": 25,
    "resolved_ci_invocation_state": 25
  },
  "data_quality_points": {
    "source_linked": 25,
    "head_sha_bound": 25,
    "required_artifact_categories_observed": 30,
    "critical_execution_states_resolved": 20
  },
  "dimension_defaults": {
    "reality": {"raw_score": 95, "confidence": 0.95},
    "build": {"raw_score": 100, "confidence": 1.0},
    "tests": {"raw_score": 100, "confidence": 1.0},
    "documentation": {"raw_score": 90, "confidence": 0.9},
    "architecture": {"raw_score": 90, "confidence": 0.85},
    "security": {"raw_score": 100, "confidence": 1.0},
    "integration": {"raw_score": 85, "confidence": 0.85},
    "recruiter_impact": {"raw_score": 85, "confidence": 0.85},
    "ai_readiness": {"raw_score": 90, "confidence": 0.85}
  },
  "required_artifact_categories": [
    "readme",
    "package_manifest",
    "workflows",
    "source_files",
    "test_files",
    "architecture_files",
    "integration_files",
    "ai_files",
    "recruiter_files"
  ],
  "critical_execution_fields": [
    "build",
    "tests",
    "documentation",
    "security"
  ]
}

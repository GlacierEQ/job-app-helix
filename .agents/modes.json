{
  "schema": "apex.agent-modes/v1",
  "repository": "glaciereq/job-app-helix",
  "purpose": "Agent operational modes for capability-focused portfolio control plane",
  "execution_modes": {
    "standard": {
      "intent": "Balanced execution with verification gates between phases",
      "parallelism": "bounded",
      "verification": "per-phase",
      "blast_radius": "scoped",
      "fail_safe": "apex-fail-safe-governor",
      "use_when": "Default for portfolio operations"
    },
    "aggressive": {
      "intent": "Maximum throughput; parallelize independent lanes, minimize wait",
      "parallelism": "max",
      "verification": "terminal-only",
      "blast_radius": "scoped",
      "fail_safe": "apex-fail-safe-governor",
      "use_when": "Well-specified capability builds with reversible mutations"
    },
    "conservative": {
      "intent": "Extra verification, rollback-safe, minimal blast radius",
      "parallelism": "serial",
      "verification": "per-step",
      "blast_radius": "minimal",
      "fail_safe": "apex-fail-safe-governor + explicit confirm",
      "use_when": "Evidence integration, legal spine operations"
    },
    "capability-build": {
      "intent": "Full verification ladder for new capability modules",
      "parallelism": "serial",
      "verification": "syntax->unit->integration->e2e->receipt",
      "blast_radius": "scoped",
      "fail_safe": "apex-fail-safe-governor",
      "use_when": "Building new capability modules in src/job_app_helix/"
    },
    "portfolio-sync": {
      "intent": "Sync portfolio state to monolith with full verification",
      "parallelism": "bounded",
      "verification": "per-phase",
      "blast_radius": "scoped",
      "fail_safe": "apex-fail-safe-governor",
      "use_when": "Running monolith.catalog_sync capability"
    }
  },
  "role_modes": {
    "repo-cartographer": {
      "skill": "apex-specialist-registry",
      "capability": "Maps repositories, interfaces, lineage, dependencies, tests",
      "trigger": "portfolio discovery, estate mapping"
    },
    "capability-miner": {
      "skill": "apex-mega-skills",
      "capability": "Finds strong mechanisms in repos, determines reusability",
      "trigger": "new capability requirement"
    },
    "connector-broker": {
      "skill": "apex-connector-mesh",
      "capability": "Discovers/invokes MCP servers, normalizes results",
      "trigger": "external capability needed"
    },
    "systems-architect": {
      "skill": "apex-orchestration",
      "capability": "Designs composable integration without destroying boundaries",
      "trigger": "cross-repo integration"
    },
    "implementation-engineer": {
      "skill": "apex-engineering-excellence",
      "capability": "Writes production-grade code, closes execution paths",
      "trigger": "capability build"
    },
    "reliability-engineer": {
      "skill": "verification",
      "capability": "Tests failure modes, observability, recovery, rollback",
      "trigger": "pre-deployment"
    },
    "performance-engineer": {
      "skill": "benchmark-suite",
      "capability": "Profiles bottlenecks, improves throughput/latency/memory",
      "trigger": "performance requirement"
    },
    "evidence-authenticator": {
      "skill": "apex-legal-intelligence",
      "capability": "Separates original evidence, copies, transcriptions, assertions",
      "trigger": "evidence integration"
    },
    "contradiction-hunter": {
      "skill": "apex-legal-intelligence",
      "capability": "Searches for conflicts across statements, dockets, metadata",
      "trigger": "pre-legal-filing"
    },
    "verification-agent": {
      "skill": "verification",
      "capability": "Independently checks claimed execution vs actual state",
      "trigger": "post-execution"
    }
  },
  "composite_modes": {
    "portfolio-sync": {
      "execution_mode": "standard",
      "workers": ["repo-cartographer", "capability-miner", "implementation-engineer", "verification-agent"],
      "use_when": "Syncing portfolio to monolith catalog"
    },
    "capability-federation": {
      "execution_mode": "aggressive",
      "workers": ["connector-broker", "systems-architect", "capability-miner", "verification-agent"],
      "use_when": "Federating capabilities across monolith + tower"
    },
    "evidence-integration": {
      "execution_mode": "conservative",
      "workers": ["evidence-authenticator", "contradiction-hunter", "verification-agent"],
      "use_when": "Integrating evidence to legal spines"
    },
    "helix-automation": {
      "execution_mode": "capability-build",
      "workers": ["implementation-engineer", "reliability-engineer", "verification-agent"],
      "use_when": "Running helix automations (brainsync, crystallization)"
    }
  }
}
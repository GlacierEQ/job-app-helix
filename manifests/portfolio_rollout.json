  "portfolio_root": "GlacierEQ/job-app-helix",
  "inventory_manifest": "manifests/portfolio_repositories.json",
  "policy": {
    "default_timeout_seconds": 300,
    "promotion_path": [
      "INVENTORY",
      "DOCUMENTATION",
      "STATIC_ANALYSIS",
      "BUILD",

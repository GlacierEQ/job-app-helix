{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "job-app-helix-control-plane",
  "public": false,
  "github": {
    "enabled": false
  },
  "buildCommand": "python3 scripts/build_recruiter_site.py --output artifacts/pages-site --source-commit $VERCEL_GIT_COMMIT_SHA",
  "outputDirectory": "artifacts/pages-site",
  "installCommand": "pip install --break-system-packages -e .",
  "devCommand": "python3 -m http.server 8000 -d artifacts/pages-site",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        {
          "key": "X-GlacierEQ-Source-bound-Public-Surface",
          "value": "https://casey-barton-glaciereq.vercel.app/"
        },
        {
          "key": "X-GlacierEQ-Deploy-Source",
          "value": "GlacierEQ/job-application#site-v15"
        }
      ]
    }
  ]
}

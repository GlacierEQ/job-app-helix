{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.local/schemas/estate/repository.schema.json",
  "title": "Repository State Capsule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository", "repository_id", "default_branch", "observed_head", "classification", "system_ids", "evidence_refs"],
  "properties": {
    "schema": {"const": "glaciereq.repository.v1"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "repository_id": {"type": "integer", "minimum": 1},
    "default_branch": {"type": "string", "minLength": 1},
    "observed_head": {"type": "string", "minLength": 6},
    "classification": {"enum": ["SOURCE_BOUND", "PREDECESSOR", "SUCCESSOR", "EXPERIMENTAL", "DEPENDENCY", "SUPPORTING_INFRASTRUCTURE", "ARCHIVED", "BACKUP", "DEMONSTRATION", "DUPLICATE", "UNKNOWN"]},
    "lineage_id": {"type": ["string", "null"]},
    "system_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.local/schemas/estate/failure-model.schema.json",
  "title": "Failure Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "failure_model_id", "system_id", "scenarios", "limitations"],
  "properties": {
    "schema": {"const": "glaciereq.failure-model.v1"},
    "failure_model_id": {"type": "string", "minLength": 1},
    "system_id": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["failure", "applicable", "detection", "containment", "explanation", "recovery", "verification_ref"],
        "properties": {
          "failure": {"type": "string", "minLength": 1},
          "applicable": {"type": "boolean"},
          "detection": {"type": "string", "minLength": 1},
          "containment": {"type": "string", "minLength": 1},
          "explanation": {"type": "string", "minLength": 1},
          "recovery": {"type": "string", "minLength": 1},
          "verification_ref": {"type": ["string", "null"]}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.local/schemas/estate/experiment.schema.json",
  "title": "Bounded Engineering Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "experiment_id", "hypothesis_id", "repository", "source_head", "branch", "success_criteria", "failure_criteria", "invariants", "instrumentation", "result_status", "evidence_ids"],
  "properties": {
    "schema": {"const": "glaciereq.experiment.v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "source_head": {"type": "string", "minLength": 6},
    "branch": {"type": "string", "minLength": 1},
    "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "failure_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "invariants": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "instrumentation": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "result_status": {"enum": ["NOT_RUN", "RUNNING", "SUPPORTED", "FALSIFIED", "INCONCLUSIVE", "BLOCKED"]},
    "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}

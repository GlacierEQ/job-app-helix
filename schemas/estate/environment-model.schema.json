{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.local/schemas/estate/environment-model.schema.json",
  "title": "System Environment Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "environment_model_id", "system_id", "machines", "software", "organizations", "economics", "humans", "scale", "evidence_refs"],
  "properties": {
    "schema": {"const": "glaciereq.environment-model.v1"},
    "environment_model_id": {"type": "string", "minLength": 1},
    "system_id": {"type": "string", "minLength": 1},
    "machines": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "software": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "organizations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "economics": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "humans": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "scale": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

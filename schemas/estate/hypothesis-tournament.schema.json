{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.local/schemas/estate/hypothesis-tournament.schema.json",
  "title": "Competing Hypothesis Tournament",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "winner_hypothesis_id", "candidates"],
  "properties": {
    "schema": {"const": "glaciereq.hypothesis-tournament.v1"},
    "winner_hypothesis_id": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "hypothesis_id", "bottleneck_fit", "expected_system_effect", "proofability", "information_advantage", "simplicity", "reuse_compounding", "novelty_confidence", "implementation_cost", "regression_risk", "uncertainty", "standard_solution_penalty", "rationale_refs", "score", "rank", "decision"],
        "properties": {
          "schema": {"const": "glaciereq.hypothesis-assessment.v1"},
          "hypothesis_id": {"type": "string", "minLength": 1},
          "bottleneck_fit": {"type": "number", "minimum": 0, "maximum": 1},
          "expected_system_effect": {"type": "number", "minimum": 0, "maximum": 1},
          "proofability": {"type": "number", "minimum": 0, "maximum": 1},
          "information_advantage": {"type": "number", "minimum": 0, "maximum": 1},
          "simplicity": {"type": "number", "minimum": 0, "maximum": 1},
          "reuse_compounding": {"type": "number", "minimum": 0, "maximum": 1},
          "novelty_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "implementation_cost": {"type": "number", "minimum": 0, "maximum": 1},
          "regression_risk": {"type": "number", "minimum": 0, "maximum": 1},
          "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
          "standard_solution_penalty": {"type": "number", "minimum": 0, "maximum": 1},
          "rationale_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "score": {"type": "number", "minimum": 0},
          "rank": {"type": "integer", "minimum": 1},
          "decision": {"enum": ["SELECTED", "REJECTED"]}
        }
      }
    }
  }
}

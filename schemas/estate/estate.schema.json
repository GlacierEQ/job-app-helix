{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.local/schemas/estate/estate.schema.json",
  "title": "Frontier Engineering Estate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_estate_schema", "source_digest", "repositories", "lineages", "systems", "capabilities", "mechanisms", "bottlenecks", "evidence"],
  "properties": {
    "schema": {"const": "glaciereq.frontier-estate.v1"},
    "source_estate_schema": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "minLength": 1},
    "repositories": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "lineages": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "systems": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "mechanisms": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "bottlenecks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}

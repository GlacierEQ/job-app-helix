{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.local/schemas/estate/engineering-run.schema.json",
  "title": "Stateful Frontier Engineering Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "repository", "expected_head", "observed_head", "state", "history"],
  "properties": {
    "schema": {"const": "glaciereq.engineering-run.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "expected_head": {"type": "string", "minLength": 6},
    "observed_head": {"type": "string", "minLength": 6},
    "branch": {"type": ["string", "null"]},
    "state": {"enum": ["DISCOVERED", "CENSUSED", "LINEAGE_RESOLVED", "BASELINE_VERIFIED", "BOTTLENECK_SELECTED", "ENVIRONMENT_MODELED", "RESEARCHED", "HYPOTHESES_EVALUATED", "EXPERIMENTING", "IMPLEMENTED", "VERIFIED", "ADVERSARIALLY_REVIEWED", "PROMOTION_READY", "SOURCE_BOUND", "MONITORED", "BLOCKED", "QUARANTINED", "SUPERSEDED", "ARCHIVED", "NO_ACTION_JUSTIFIED", "EXPERIMENT_FAILED"]},
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "evidence_refs"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "blocked_from_state": {"type": ["string", "null"]},
    "census_ref": {"type": "string", "minLength": 1},
    "lineage_ref": {"type": "string", "minLength": 1},
    "baseline_verification_id": {"type": "string", "minLength": 1},
    "baseline_status": {"enum": ["VERIFIED", "FAILED", "PARTIAL", "BLOCKED"]},
    "bottleneck_id": {"type": "string", "minLength": 1},
    "environment_model_id": {"type": "string", "minLength": 1},
    "research_record_id": {"type": "string", "minLength": 1},
    "research_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "hypothesis_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "hypothesis_tournament_id": {"type": "string", "minLength": 1},
    "novelty_review_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "novelty_decision": {"enum": ["REJECT", "ADAPT", "PROCEED"]},
    "experiment_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "failure_model_id": {"type": "string", "minLength": 1},
    "observability_contract_id": {"type": "string", "minLength": 1},
    "adversarial_review_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "adversarial_review_decision": {"enum": ["SURVIVES", "REWORK", "INVALIDATED"]},
    "promotion_id": {"type": ["string", "null"]},
    "promotion_record": {"type": "object"},
    "promotion_ready": {"type": "boolean"},
    "source_commit": {"type": "string", "minLength": 6},
    "verification_status": {"enum": ["VERIFIED", "FAILED", "PARTIAL", "BLOCKED"]},
    "system": {"type": "string", "minLength": 1},
    "bottleneck": {"type": "string", "minLength": 1},
    "root_cause": {"type": "string", "minLength": 1},
    "invention": {"type": "string", "minLength": 1},
    "implementation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "measured_results": {"type": "array", "items": {"type": "object"}},
    "enterprise_consequence": {"type": "string", "minLength": 1},
    "failure_boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "next_constraint": {"type": "string", "minLength": 1}
  }
}

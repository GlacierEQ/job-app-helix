{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.local/schemas/estate/promotion.schema.json",
  "title": "Source-bound Promotion Gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository", "source_head", "expected_head", "observed_head", "baseline_preserved", "central_mechanism_implemented", "existing_tests_pass", "new_behavior_tested", "failure_path_tested", "regression_risk_assessed", "claims_match_evidence", "architecture_documented", "limitations_documented", "benchmark", "decision", "evidence_refs"],
  "properties": {
    "schema": {"const": "glaciereq.promotion.v1"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "source_head": {"type": "string", "minLength": 6},
    "expected_head": {"type": "string", "minLength": 6},
    "observed_head": {"type": "string", "minLength": 6},
    "baseline_preserved": {"type": "boolean"},
    "central_mechanism_implemented": {"type": "boolean"},
    "existing_tests_pass": {"type": "boolean"},
    "new_behavior_tested": {"type": "boolean"},
    "failure_path_tested": {"type": "boolean"},
    "regression_risk_assessed": {"type": "boolean"},
    "claims_match_evidence": {"type": "boolean"},
    "architecture_documented": {"type": "boolean"},
    "limitations_documented": {"type": "boolean"},
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "measured", "results", "reason"],
      "properties": {
        "required": {"type": "boolean"},
        "measured": {"type": "boolean"},
        "results": {"type": "array", "items": {"type": "object"}},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "decision": {"enum": ["PROMOTION_READY", "REJECTED", "BLOCKED"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

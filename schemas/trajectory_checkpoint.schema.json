{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/GlacierEQ/job-app-helix/main/schemas/trajectory_checkpoint.schema.json",
  "title": "GlacierEQ Trajectory Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "date", "timezone", "captured_at_hst", "capture_kind", "phase", "resolution", "authority", "state", "delta", "receipt"],
  "properties": {
    "schema": {"const": "glaciereq.trajectory-checkpoint.v1"},
    "date": {"type": "string", "format": "date", "pattern": "^2026-"},
    "timezone": {"const": "Pacific/Honolulu"},
    "captured_at_hst": {"type": "string", "minLength": 20},
    "capture_kind": {"enum": ["historical_reconstruction", "contemporary"]},
    "phase": {"enum": ["expansion", "acceleration", "composition", "rupture", "diagnosis", "counter-engineering", "recovery", "stronger expansion"]},
    "resolution": {"enum": ["monthly", "semi-monthly", "biweekly", "five-day", "two-day", "three-day"]},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "schedule_path", "schedule_sha256", "github_owner"],
      "properties": {
        "repository": {"const": "GlacierEQ/job-app-helix"},
        "schedule_path": {"const": "machine/trajectory/2026_schedule.json"},
        "schedule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schedule_semantics": {"const": "current_reconstruction_contract_not_historical_state"},
        "github_owner": {"const": "GlacierEQ"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_inventory", "canonical_heads", "dimensions", "source_hashes"],
      "properties": {
        "repository_inventory": {
          "type": "object",
          "required": ["owned_repository_count", "visibility_counts", "archived_count", "active_count", "fork_count", "native_count"],
          "properties": {
            "owned_repository_count": {"type": ["integer", "null"], "minimum": 0},
            "visibility_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
            "archived_count": {"type": ["integer", "null"], "minimum": 0},
            "active_count": {"type": ["integer", "null"], "minimum": 0},
            "fork_count": {"type": ["integer", "null"], "minimum": 0},
            "native_count": {"type": ["integer", "null"], "minimum": 0},
            "bounded_survivor_repository_count": {"type": "integer", "minimum": 0},
            "inventory_semantics": {"type": "string"},
            "visibility_semantics": {"type": "string"},
            "exact_historical_repository_count_known": {"type": "boolean"},
            "deleted_or_transferred_repository_gap_resolved": {"type": "boolean"}
          }
        },
        "canonical_heads": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["repository", "default_branch", "head_sha", "visibility", "archived", "fork", "created_at", "updated_at"],
            "properties": {
              "repository": {"type": "string"},
              "default_branch": {"type": ["string", "null"]},
              "head_sha": {"type": ["string", "null"]},
              "head_committed_at": {"type": ["string", "null"]},
              "visibility": {"type": "string"},
              "archived": {"type": "boolean"},
              "fork": {"type": "boolean"},
              "created_at": {"type": "string"},
              "updated_at": {"type": "string"},
              "evidence_class": {"type": "string"},
              "branch_semantics": {"type": "string"},
              "metadata_semantics": {"type": "string"}
            }
          }
        },
        "dimensions": {
          "type": "object",
          "minProperties": 14,
          "additionalProperties": {
            "type": "object",
            "required": ["sources", "file_count", "tree_sha256"],
            "properties": {
              "sources": {"type": "array", "items": {"type": "string"}},
              "file_count": {"type": "integer", "minimum": 0},
              "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "evidence_class": {"type": "string"},
              "authority_commit": {"type": ["string", "null"]},
              "authority_tree": {"type": ["string", "null"]}
            }
          }
        },
        "source_hashes": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "delta": {
      "type": "object",
      "required": ["status", "previous_checkpoint_expected", "previous_checkpoint", "repository_count_delta", "repositories_added", "repositories_removed", "canonical_head_changes", "dimension_changes"],
      "properties": {
        "status": {"enum": ["computed", "previous_checkpoint_not_materialized", "bounded_historical_reconstruction"]},
        "previous_checkpoint_expected": {"type": ["string", "null"]},
        "previous_checkpoint": {"type": ["string", "null"]},
        "repository_count_delta": {"type": ["integer", "null"]},
        "repositories_added": {"type": "array", "items": {"type": "string"}},
        "repositories_removed": {"type": "array", "items": {"type": "string"}},
        "canonical_head_changes": {"type": "array"},
        "dimension_changes": {"type": "array", "items": {"type": "string"}},
        "dimension_evidence_transitions": {"type": "array"},
        "delta_semantics": {"type": "string"}
      }
    },
    "reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cutoff_hst", "cutoff_semantics", "estate_evidence_class", "authority_tree_evidence_class", "authority_commit_status", "current_repository_count_observed", "survivors_created_by_cutoff", "current_survivors_created_after_cutoff", "limitations"],
      "properties": {
        "cutoff_hst": {"type": "string"},
        "cutoff_semantics": {"type": "string"},
        "estate_evidence_class": {"const": "bounded_current_survivors"},
        "authority_tree_evidence_class": {"enum": ["exact_git_tree_at_cutoff", "unresolved_authority_not_yet_created"]},
        "authority_commit_status": {"enum": ["resolved", "not_yet_created_at_cutoff"]},
        "current_repository_count_observed": {"type": "integer", "minimum": 0},
        "survivors_created_by_cutoff": {"type": "integer", "minimum": 0},
        "current_survivors_created_after_cutoff": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "checkpoint_sha256"],
      "properties": {
        "hash_algorithm": {"const": "sha256"},
        "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"capture_kind": {"const": "historical_reconstruction"}}},
      "then": {"required": ["reconstruction"]},
      "else": {"not": {"required": ["reconstruction"]}}
    }
  ]
}
